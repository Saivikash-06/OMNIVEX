# ============================================================
# OMNIVEX AI Reliability Monitor - Environment Configuration
# Academic Research Prototype (Not for Safety-Critical Production)
# ============================================================

# Project and Server Configuration
PROJECT_NAME="OMNIVEX AI Reliability Monitor"
VERSION="2.0.0"
HOST=127.0.0.1
PORT=8000
DOCS_ENABLED=true

# Database Connection (SQLite)
DATABASE_URL="sqlite:///./omnivex.db"

# Optional API Key Authentication
# If set, all endpoints except /api/health require header X-API-Key: <key>
# Leave blank/unset for open local development
OMNIVEX_API_KEY=

# Allowed CORS Origins (comma-separated if parsed, JSON list format)
CORS_ORIGINS='["http://localhost:8501", "http://127.0.0.1:8501"]'

# Request & Storage Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB streaming upload cap
MAX_ROWS=100000
MAX_COLUMNS=200
MAX_FEATURES=100
MAX_BOOTSTRAP_RESAMPLES=1000
MAX_EXPERIMENT_REPEATS=10
PER_RUN_TIME_BUDGET_SECONDS=60

# Rate Limiter Settings (SlowAPI format: count/unit)
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_STRICT="20/minute"

# Statistical Drift and Monitoring Thresholds
KS_ALPHA=0.05
KS_MIN_EFFECT=0.10
PSI_MODERATE=0.10
PSI_MAJOR=0.25
MIN_SAMPLES_DRIFT=30
MIN_SAMPLES_PERFORMANCE=30
PERFORMANCE_DROP_TOLERANCE=0.05
DRIFT_RATIO_THRESHOLD=0.30
MAX_ALERTS_PER_RUN=20
